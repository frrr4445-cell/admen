{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "api/**",
      "scripts/**",
      "README*",
      "AUDIT*",
      "package.json",
      "package-lock.json",
      "vercel.json",
      "*.rules"
    ]
  }
}
