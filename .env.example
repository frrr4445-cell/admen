# Vercel Project > Settings > Environment Variables
# Keep all secret values out of GitHub and browser-side files.
OPENAI_API_KEY=sk-proj-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Paste the complete Firebase service-account JSON as one environment-variable value.
# Create a dedicated service account with least-privilege Firestore access.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}

# PayPal REST API credentials (Sandbox first)
PAYPAL_CLIENT_ID=YOUR_PAYPAL_REST_APP_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_REST_APP_SECRET
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID
PUBLIC_APP_URL=https://YOUR-PROJECT.vercel.app
# Optional comma-separated exact origins for Vercel Preview deployments/local staging
ALLOWED_ORIGINS=https://YOUR-PROJECT-git-branch.vercel.app


# Enable only after adding the reCAPTCHA v3 site key to firebase-config.js and registering domains.
ENFORCE_APP_CHECK=false

# Required for signed ticket QR codes (generate with: openssl rand -hex 32)
TICKET_SIGNING_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS

# Optional transactional booking confirmations via Resend.
# Verify your sending domain in Resend before using a production sender.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
TRANSACTIONAL_EMAIL_FROM=Travel Touch <bookings@your-verified-domain.com>
